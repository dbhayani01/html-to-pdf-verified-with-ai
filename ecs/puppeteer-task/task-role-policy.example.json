{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadHtmlInput",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::REPLACE_WITH_INPUT_BUCKET/REPLACE_WITH_INPUT_PREFIX/*"
    },
    {
      "Sid": "WriteFinalArtifactsAfterProcessing",
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource": "arn:aws:s3:::REPLACE_WITH_OUTPUT_BUCKET/REPLACE_WITH_OUTPUT_PREFIX/*"
    }
  ]
}
